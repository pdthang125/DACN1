generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================
// ENUMS
// ====================================================

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  RESCHEDULE_PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum TimeOffType {
  VACATION
  SICK_LEAVE
  CONFERENCE
  PERSONAL
  HOLIDAY
}

enum OverrideType {
  OVERTIME
  MODIFIED_HOURS
  ROOM_CHANGE
}

enum AttachmentType {
  XRAY
  INTRAORAL_PHOTO
  PRESCRIPTION
  TREATMENT_PLAN
  OTHER
}

// ====================================================
// MODELS
// ====================================================

// 1. TÀI KHOẢN ĐĂNG NHẬP (CLERK AUTH)
model User {
  id              String        @id @default(cuid())
  clerkId         String        @unique
  email           String        @unique
  firstName       String?
  lastName        String?
  phone           String?
  role            UserRole      @default(PATIENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  managedPatients Patient[]
  doctorProfile   Doctor?
  auditLogs       AuditLog[]

  @@map("users")
}

// 2. DANH MỤC DỊCH VỤ NHA KHOA (QUYẾT ĐỊNH THỜI LƯỢNG SLOT KHÁM)
model Service {
  id              String        @id @default(cuid())
  name            String        // "Cạo vôi răng", "Nhổ răng khôn", "Trồng Implant"
  code            String        @unique // "SC-CLEAN", "SC-EXTRACT"
  description     String?
  durationMinutes Int           @default(30) // Thời lượng thực tế của dịch vụ
  price           Decimal       @db.Decimal(12, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments    Appointment[]

  @@map("services")
}

// 3. HỒ SƠ BỆNH NHÂN (TÁCH BIỆT KHỎI TÀI KHOẢN)
model Patient {
  id               String          @id @default(cuid())
  fullName         String
  dateOfBirth      DateTime        @db.Date
  gender           Gender
  phone            String?
  nationalId       String?         // CCCD
  address          String?
  emergencyContact String?
  bloodType        String?
  allergies        String?         // Dị ứng kháng sinh, tê...
  medicalAlerts    String?         // Bệnh nền: tim mạch, máu khó đông
  isPrimary        Boolean         @default(false) // Đánh dấu là hồ sơ của chính chủ tài khoản

  // Cờ AI
  aiDataConsent    Boolean         @default(false)
  aiConsentDate    DateTime?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  managedById      String
  managedBy        User            @relation(fields: [managedById], references: [id], onDelete: Cascade)

  appointments     Appointment[]

  @@index([managedById])
  @@map("patients")
}

// 4. PHÒNG KHÁM / GHẾ NHA KHOA
model Room {
  id                String                   @id @default(cuid())
  name              String
  roomNumber        String                   @unique
  description       String?
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  defaultDoctors    Doctor[]                 @relation("DefaultDoctorRoom")
  workingSchedules  DoctorSchedule[]
  scheduleOverrides DoctorScheduleOverride[]
  appointments      Appointment[]

  @@map("rooms")
}

// 5. HỒ SƠ BÁC SĨ
model Doctor {
  id             String                   @id @default(cuid())
  name           String
  email          String                   @unique
  phone          String
  speciality     String
  bio            String?
  imageUrl       String
  gender         Gender
  isActive       Boolean                  @default(true)
  employmentType EmploymentType           @default(FULL_TIME)

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  userId         String?                  @unique
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  defaultRoomId  String?
  defaultRoom    Room?                    @relation("DefaultDoctorRoom", fields: [defaultRoomId], references: [id])

  schedules      DoctorSchedule[]
  timeOffs       DoctorTimeOff[]
  overrides      DoctorScheduleOverride[]
  appointments   Appointment[]

  @@map("doctors")
}

// 6. LỊCH LÀM VIỆC ĐỊNH KỲ (CÓ NGHỈ TRƯA & HIỆU LỰC)
model DoctorSchedule {
  id            String    @id @default(cuid())
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  dayOfWeek     Int       // 0: CN, 1: T2, ..., 6: T7
  
  // Ca làm việc chính
  startTime     String    // "08:00"
  endTime       String    // "17:00"
  
  // Khung nghỉ trưa / nghỉ giữa ca (Tránh sinh slot vào giờ này)
  breakStart    String?   // "12:00"
  breakEnd      String?   // "13:30"

  slotDuration  Int       @default(30) // Bước nhảy slot (15, 30 phút)

  // Hiệu lực lịch áp dụng
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  roomId        String?
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([doctorId, effectiveFrom, effectiveTo])
  @@map("doctor_schedules")
}

// 7. NGHỈ PHÉP DÀI NGÀY / ĐỘT XUẤT (KHOẢNG THỜI GIAN)
model DoctorTimeOff {
  id         String      @id @default(cuid())
  doctorId   String
  doctor     Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  startAt    DateTime    // Bắt đầu nghỉ (có timezone)
  endAt      DateTime    // Kết thúc nghỉ
  type       TimeOffType @default(VACATION)
  reason     String?
  isApproved Boolean     @default(true)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([doctorId, startAt, endAt])
  @@map("doctor_time_offs")
}

// 8. BIẾN ĐỘNG TRONG NGÀY
model DoctorScheduleOverride {
  id           String       @id @default(cuid())
  doctorId     String
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  date         DateTime     @db.Date
  type         OverrideType
  
  startTime    String?      // "18:00"
  endTime      String?      // "20:00"
  reason       String?

  targetRoomId String?
  targetRoom   Room?        @relation(fields: [targetRoomId], references: [id], onDelete: SetNull)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([doctorId, date])
  @@map("doctor_schedule_overrides")
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  SEPAY
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

// 9. LỊCH HẸN KHÁM (DÙNG TIMESTAMP CHUẨN ĐỂ CHECK TRÙNG LỊCH)
model Appointment {
  id                 String            @id @default(cuid())
  
  // Dùng DateTime đầy đủ (Timestamp) để index và so sánh thời gian cực nhanh
  startAt            DateTime          // 2026-10-30T09:00:00.000Z
  endAt              DateTime          // 2026-10-30T09:45:00.000Z
  
  status             AppointmentStatus @default(PENDING_PAYMENT)
  symptom            String
  notes              String?
  phoneNumber        String?

  // Gắn dịch vụ cụ thể
  serviceId          String?
  service            Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Xử lý hủy lịch
  cancellationReason String?
  cancelledByRole    UserRole?
  cancelledAt        DateTime?

  // Luồng dời lịch
  rescheduledFromId  String?           @unique
  rescheduledFrom    Appointment?      @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo      Appointment?      @relation("AppointmentReschedule")

  proposedStartAt    DateTime?
  proposedEndAt      DateTime?
  proposedReason     String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId           String
  doctor             Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  roomId             String?
  room               Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)

  medicalRecord      MedicalRecord?
  payment            Payment?

  // Index chống trùng và tối ưu query lịch
  @@index([doctorId, startAt, endAt])
  @@index([patientId, startAt])
  @@map("appointments")
}

// 10. HỒ SƠ BỆNH ÁN
model MedicalRecord {
  id            String      @id @default(cuid())
  diagnosis     String
  treatment     String
  prescription  String?
  doctorNotes   String?
  followUpDate  DateTime?   @db.Date

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Mỗi lịch hẹn có tối đa một bệnh án.
  // Patient và Doctor được truy xuất thông qua Appointment để tránh dữ liệu trùng lặp.
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  attachments   RecordAttachment[]

  @@map("medical_records")
}

// 11. ĐÍNH KÈM PHIM CHỤP / ẢNH RĂNG
model RecordAttachment {
  id               String         @id @default(cuid())
  medicalRecordId  String
  medicalRecord    MedicalRecord  @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  fileUrl          String
  fileName         String
  fileType         AttachmentType @default(XRAY)
  description      String?
  aiAnalyzed       Boolean        @default(false)
  aiAnalysisResult Json?

  createdAt        DateTime       @default(now())

  @@map("record_attachments")
}

// 12. AUDIT LOG
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
model Payment {
  id            String          @id @default(cuid())
  appointmentId String          @unique
  paymentCode   String          @unique
  amount        Decimal         @db.Decimal(12, 2)
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(SEPAY)

  expiresAt     DateTime
  paidAt        DateTime?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  appointment   Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  transactions  PaymentTransaction[]

  @@index([status, expiresAt])
  @@map("payments")
}

model PaymentTransaction {
  id                    String   @id @default(cuid())
  paymentId             String
  sepayTransactionId    String   @unique
  transferAmount        Decimal  @db.Decimal(12, 2)
  transferType          String
  referenceCode          String?
  transactionDate        DateTime?
  isMatched              Boolean  @default(false)
  rawPayload             Json

  createdAt              DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_transactions")
}